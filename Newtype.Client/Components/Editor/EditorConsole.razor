@using Microsoft.AspNetCore.Components.Web

<div class="editor-container"
     @onkeydown="HandleKeyDown"
     @onkeydown:preventDefault="shouldPreventDefault"
     tabindex="0">

    <div class="canvas">
        <div class="cursor" style="left: @(Col)ch; top: @(Row * 1.5)rem;"></div>

        @for (int i = 0; i < Console.Count; i++)
        {
            <div class="line">
                <span>@Console[i].ToString()</span>
            </div>
        }
    </div>
    
    <div class="status-bar">
        <span>@CurrentMode</span>
        <span>@(Row + 1):@(Col + 1)</span>
    </div>
</div>
