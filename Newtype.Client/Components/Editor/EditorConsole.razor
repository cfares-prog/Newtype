@using Microsoft.AspNetCore.Components.Web

<div class="newtype-layout @(IsTreeOpen ? "tree-open" : "tree-closed")">
    
    <div class="file-tree-container">
        <div class="tree-header">
            <span>EXPLORER</span>
            <button class="toggle-btn" @onclick="ToggleTree" tabindex="-1">◀</button>
        </div>
        <div class="tree-content">
            <div class="tree-item"><i class="nf nf-fa-folder"></i> src</div>
            <div class="tree-item file"><i class="nf nf-fa-file_code"></i> main.c</div>
            <div class="tree-item file"><i class="nf nf-fa-file_code"></i> program.cs</div>
        </div>
    </div>

    <div class="editor-main">
        @if (!IsTreeOpen)
        {
            <button class="toggle-btn open-btn" @onclick="ToggleTree" tabindex="-1">▶</button>
        }

        <div class="editor-tab-bar" style="display: flex; justify-content: space-between; align-items: center; padding: 0.25rem 1rem; background: #121212; border-bottom: 1px solid #282828;">
            <span style="color: #8f8f8f; font-family: monospace;">main.c</span>
            <button @onclick="RunCodeAsync" disabled="@IsCompiling" style="background: #2b2b2b; color: #e4e4ef; border: none; padding: 0.25rem 0.75rem; cursor: pointer; font-family: inherit;">
                <i class="nf nf-fa-play"></i> @(IsCompiling ? "Compiling..." : "Run Code")
            </button>
        </div>

        <div class="editor-container"
             @onkeydown="HandleKeyDown"
             @onkeydown:preventDefault="shouldPreventDefault"
             tabindex="0">
             
            <div class="canvas">
                @for (int i = 0; i < Console.Count; i++)
                {
                    <div class="line">
                        @{
                            var lineText = Console[i].ToString();
                            if(string.IsNullOrEmpty(lineText))
                            {
                                <span>&#8203;</span>
                            }
                            else
                            {
                                <span>@lineText</span>
                            }
                        }
                    </div>
                }
                <div class="cursor" style="left: @(Col)ch; top: @(Row * 1.5)rem;"></div>
            </div>
        </div>

        @if (IsTerminalOpen)
        {
            <div class="terminal-drawer" style="height: 200px; background: #0f0f0f; border-top: 1px solid #282828; display: flex; flex-direction: column;">
                <div class="terminal-header" style="display: flex; justify-content: space-between; padding: 0.25rem 0.5rem; background: #151515; font-size: 0.8rem; color: #888;">
                    <span>OUTPUT CONSOLE</span>
                    <button @onclick="() => IsTerminalOpen = false" style="background: none; border: none; color: #888; cursor: pointer;">✖</button>
                </div>
                <div class="terminal-body" style="flex: 1; overflow-y: auto; padding: 0.5rem; font-family: 'Iosevka Nerd Font', monospace; color: #d4d4d4;">
                    @foreach (var line in TerminalLines)
                    {
                        <div style="white-space: pre-wrap;">@line</div>
                    }
                </div>
            </div>
        }

        <StatusBar CurrentMode="@CurrentMode" Row="@Row" Col="@Col" />
    </div>
</div>
